# Hugging Face Hub token. Optional -- without it the server downloads models
# anonymously, which works for public repos.
HF_KEY=...

# API keys accepted by the /api routes (comma-separated, see api/auth.py).
#
# Leaving both empty disables authentication entirely and every route is open,
# which is the local-development default. Any server reachable from outside
# localhost must set at least EPHEMERIS_SERVER_API_KEYS.
#
# Ordinary keys: /api/generate, /api/generate_batch, GET /api/model, /api/metrics.
EPHEMERIS_SERVER_API_KEYS=

# Admin keys: additionally allowed to POST /api/model, which makes the server
# download and load an arbitrary Hugging Face repo. Keep this separate from the
# keys handed to ordinary clients. Admin keys satisfy the ordinary tier too.
EPHEMERIS_SERVER_ADMIN_API_KEYS=

# Generate keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

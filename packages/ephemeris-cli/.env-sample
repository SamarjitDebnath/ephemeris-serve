# Environment for the ephemeris chat client.
#
# Copy to `.env` in this directory (it is gitignored) and fill in your values:
#
#   cp .env-sample .env && chmod 600 .env
#
# Only the EPHEMERIS_CLIENT_* names below are read. Any other entry in this or
# any other .env -- including the server's own HF_KEY and EPHEMERIS_SERVER_*
# keys -- is ignored by the client, so the two sides never read each other's
# configuration even when a single .env holds both.
#
# .env files are consulted in this order, later ones winning:
#   1. this file (packages/ephemeris-cli/.env)
#   2. ~/.config/ephemeris/.env
#   3. ./.env in the directory you run `ephemeris` from
#   4. the file named by EPHEMERIS_CLIENT_ENV
#
# Real environment variables always beat all of them, and command-line options
# beat everything.

# Address of the server to talk to, including scheme and port.
EPHEMERIS_CLIENT_URL=https://ephemeris.example.com:8080

# API key, sent as "Authorization: Bearer <key>". Leave empty for a server
# with no keys configured. This is the server operator's ordinary-tier key --
# it is NOT the same variable the server itself reads.
EPHEMERIS_CLIENT_API_KEY=

# Optional: path to a client YAML config, if you keep one outside the
# standard ~/.config/ephemeris/client.yaml location.
# EPHEMERIS_CLIENT_CONFIG=
